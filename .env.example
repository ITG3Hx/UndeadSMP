# In Railway unter "Variables" eintragen (die .env selbst wird nicht deployed).

# Bot-Token aus dem Discord Developer Portal
DISCORD_TOKEN=

# Passwort fuer das Dashboard. Ohne das startet die Weboberflaeche absichtlich nicht.
DASHBOARD_PASSWORD=

# Optional: auf welchen Server sich das Dashboard bezieht. Leer = erster Server, auf dem der Bot ist.
GUILD_ID=

# Optional: wo config.json liegt. In Railway ein Volume auf /data mounten und hier /data eintragen,
# sonst sind die Dashboard-Einstellungen nach jedem Redeploy weg.
DATA_DIR=./data

# Wird von Railway automatisch gesetzt, lokal Standard 3000
PORT=3000
